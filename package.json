{
  "name": "homeledger",
  "version": "1.2.0",
  "private": true,
  "description": "HomeLedger - self-hosted personal finance manager, expense tracker and budgeting app with a Home Assistant add-on. Runs on Docker.",
  "homepage": "https://github.com/TastingRogue/HomeLedger#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TastingRogue/HomeLedger.git"
  },
  "bugs": {
    "url": "https://github.com/TastingRogue/HomeLedger/issues"
  },
  "author": "TastingRogue",
  "license": "MIT",
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "budgeting",
    "budget",
    "money-manager",
    "finance",
    "self-hosted",
    "selfhosted",
    "homelab",
    "home-assistant",
    "hacs",
    "docker",
    "sveltekit",
    "fastify",
    "sqlite",
    "typescript",
    "mint-alternative",
    "ynab-alternative"
  ],
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/shared"
  ],
  "overrides": {
    "esbuild": "^0.25.0",
    "glob": "^14.0.2",
    "tinypool": "^2.2.0",
    "minimatch": "^11.0.4",
    "cookie@<0.7.0": "^0.7.0"
  },
  "scripts": {
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "build": "npm run build -w packages/shared && npm run build -w packages/backend && npm run build -w packages/frontend",
    "test": "npm run locales:check && npm run locales:test && vitest run && npm run test -w packages/frontend",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src/**/*.ts",
    "format": "prettier --write \"packages/*/src/**/*.{ts,svelte,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,svelte,json}\"",
    "locales:sync": "node scripts/locales.mjs",
    "locales:check": "node scripts/locales.mjs --check",
    "locales:test": "node --test scripts/locales.test.mjs",
    "locales:add": "node scripts/add-locale.mjs",
    "prebuild": "npm run locales:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
