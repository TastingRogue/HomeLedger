# Smart Finance - Environment Variables

# JWT secret for token signing (use a strong random string, min 32 chars)
JWT_SECRET=change-me-to-a-strong-random-secret

# Admin user credentials (created on first run)
ADMIN_EMAIL=admin@smartfinance.local
ADMIN_PASSWORD=change-me-to-a-strong-password

# Timezone (used for scheduled tasks and date formatting)
TZ=America/Mexico_City

# Directory for SQLite database and attachments
DATA_DIR=./data

# Server port
PORT=3000
