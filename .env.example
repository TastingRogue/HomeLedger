# HomeLedger - Environment Variables
# Copy this file to .env and configure for your deployment

# ============================================================================
# Security Settings
# ============================================================================

# JWT secret for token signing (use a strong random string, min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-secret

# Allowed CORS origins (comma-separated). Restrict this in production to the
# domain(s) that serve the frontend, e.g. https://ledger.example.com
# If unset, the server reflects the request origin (fine for single-host
# self-hosted setups where the app and API share the same origin).
# CORS_ORIGIN=https://ledger.example.com

# ============================================================================
# Admin User (Created on First Run)
# ============================================================================

# Initial admin email
ADMIN_EMAIL=admin@homeledger.local

# Initial admin password (change immediately after first login)
ADMIN_PASSWORD=change-me-to-a-strong-password

# ============================================================================
# Application Configuration
# ============================================================================

# Node environment
NODE_ENV=production

# Log verbosity (pino levels): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Server port (for Docker: internal port 3000, exposed via docker-compose)
PORT=3000

# Server hostname (for Docker, use 0.0.0.0 to accept all interfaces)
HOST=0.0.0.0

# Timezone for scheduled tasks and date formatting
TZ=America/Mexico_City

# Primary language for the install, chosen by the admin/host. Determines the
# language the default system categories are seeded in on first run. Supported:
# 'es' (Spanish) or 'en' (English). Defaults to English if unset/invalid.
# Individual users can still switch their own UI language afterwards.
DEFAULT_LOCALE=en

# ============================================================================
# Data Storage
# ============================================================================

# Directory for SQLite database and file attachments
# For Docker: use /data (persistent volume)
# For local: use ./data or absolute path
DATA_DIR=/data

# ============================================================================
# Automated Backups
# ============================================================================

# Enable the scheduled database backup job (gzip whole-DB snapshots under
# $DATA_DIR/backups). Set to false to disable. Default: enabled.
BACKUP_ENABLED=true

# How many snapshots to keep; older ones are rotated out. Default: 7.
BACKUP_RETENTION=7

# Cron schedule for automated backups (server timezone). Default: daily 03:00.
BACKUP_CRON=0 3 * * *
